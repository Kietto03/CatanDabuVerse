# Copy to supabase/.env (git-ignored). Read by `supabase start` for env() values in config.toml.
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client, Web application)
#   Authorized redirect URI (local): http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Discord: https://discord.com/developers/applications → OAuth2
#   Redirect (local): http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
