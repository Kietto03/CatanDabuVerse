# Game server settings. Copy to .env (git-ignored); server.py loads it on start.
# Leave SUPABASE_URL empty to run without login (legacy name-only seats).

# Postgres connection used by the game server (service role, bypasses RLS).
#   local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   hosted: Dashboard → Connect → Session pooler connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL. When set, every socket must present a valid access token.
SUPABASE_URL=http://127.0.0.1:54321

# Only for projects still signing tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# Random string; client IPs are stored only as salted hashes.
IP_HASH_SALT=change-me
